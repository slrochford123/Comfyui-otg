[Unit]
Description=ComfyUI-OTG TEST Linux Applio Training Worker
After=network-online.target otg-test.service otg-character-indextts2-dataset-worker.service
Wants=network-online.target

[Service]
Type=simple
User=shawn-rochford
Group=shawn-rochford
WorkingDirectory=/home/shawn-rochford/AI/runtime/test/Applio
EnvironmentFile=/etc/otg/character-applio-training-worker.env
ExecStart=/home/shawn-rochford/AI/runtime/test/Applio/.venv/bin/python /home/shawn-rochford/AI/deploy/otg-test/current/scripts/linux/otg-character-applio-training-worker.py
Restart=always
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/shawn-rochford/AI/runtime/test /home/shawn-rochford/AI/deploy/otg-test /home/shawn-rochford/AI/work/OTG-Test2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
