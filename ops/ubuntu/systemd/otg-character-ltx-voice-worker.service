[Unit]
Description=ComfyUI-OTG TEST Linux LTX Character Voice Worker
Wants=network-online.target otg-comfyui.service
After=network-online.target otg-test.service otg-comfyui.service
Requires=otg-test.service

[Service]
Type=simple
User=shawn-rochford
Group=shawn-rochford
WorkingDirectory=/home/shawn-rochford/AI/deploy/otg-test/current
EnvironmentFile=/etc/otg/character-completion-worker.env
EnvironmentFile=/etc/otg/character-ltx-voice-worker.env
ExecStart=/usr/bin/python3 /home/shawn-rochford/AI/deploy/otg-test/current/scripts/linux/otg-character-ltx-voice-worker.py
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/shawn-rochford/AI/runtime/test /home/shawn-rochford/AI/deploy/otg-test

[Install]
WantedBy=multi-user.target
