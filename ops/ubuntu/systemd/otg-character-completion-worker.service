[Unit]
Description=ComfyUI-OTG TEST Character Completion Worker
Wants=network-online.target
After=network-online.target otg-test.service
Requires=otg-test.service

[Service]
Type=simple
User=shawn-rochford
Group=shawn-rochford
WorkingDirectory=/home/shawn-rochford/AI/deploy/otg-test/current
EnvironmentFile=/etc/otg/character-completion-worker.env
ExecStart=/usr/bin/python3 /home/shawn-rochford/AI/deploy/otg-test/current/scripts/linux/otg-character-completion-worker.py --base-url http://100.75.162.64:3001 --device-id linux-character-completion --worker-id linux-character-completion-worker --interval-seconds 10 --card-timeout-seconds 1800
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/shawn-rochford/AI/runtime/test /home/shawn-rochford/AI/deploy/otg-test /home/shawn-rochford/AI/work/OTG-Test2

[Install]
WantedBy=multi-user.target
