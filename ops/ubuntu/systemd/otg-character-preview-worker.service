[Unit]
Description=ComfyUI-OTG TEST Linux Character Preview Dub Worker
After=network-online.target otg-test.service otg-character-applio-training-worker.service
Wants=network-online.target
Requires=otg-test.service

[Service]
Type=simple
User=shawn-rochford
Group=shawn-rochford
WorkingDirectory=/home/shawn-rochford/AI/deploy/otg-test/current
EnvironmentFile=/etc/otg/character-preview-worker.env
ExecStart=/usr/bin/python3 /home/shawn-rochford/AI/deploy/otg-test/current/scripts/linux/otg-character-preview-worker.py
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
