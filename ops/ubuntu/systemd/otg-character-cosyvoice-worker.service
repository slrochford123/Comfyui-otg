[Unit]
Description=ComfyUI-OTG TEST Linux CosyVoice3 Character Worker
Wants=network-online.target
After=network-online.target otg-test.service
Requires=otg-test.service

[Service]
Type=simple
User=shawn-rochford
Group=shawn-rochford
WorkingDirectory=/home/shawn-rochford/AI/deploy/otg-test/current
EnvironmentFile=/etc/otg/character-cosyvoice-worker.env
ExecStart=/home/shawn-rochford/AI/runtime/test/cosyvoice-env/bin/python /home/shawn-rochford/AI/deploy/otg-test/current/scripts/linux/otg-character-cosyvoice-worker.py
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/shawn-rochford/AI/runtime/test /home/shawn-rochford/AI/deploy/otg-test /home/shawn-rochford/AI/work/OTG-Test2

[Install]
WantedBy=multi-user.target
