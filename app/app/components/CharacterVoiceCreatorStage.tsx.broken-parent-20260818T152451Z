"use client";

import React from "react";

import CharacterVoiceFxStage, { type FinalVoiceSelection } from "./CharacterVoiceFxStage";

type ProviderId = "minimax_h3" | "ltx25";
type LibraryId = "natural" | "fictional";
type AgeId = "child" | "teenager" | "adult" | "elderly";
type PresentationId = "male" | "female";

type VoicePreset = {
  id: string;
  label: string;
  category: string;
  age: string;
  presentation: string;
  description: string;
  auditionLine: string;
};

type Catalogs = {
  minimax_h3: {
    natural: VoicePreset[];
    fictional: VoicePreset[];
  };
  ltx25: {
    natural: VoicePreset[];
    fictional: VoicePreset[];
  };
};

type CharacterRecord = {
  id: string;
  name: string;
  description?: string;
};

type AuditionResult = {
  voiceId: string;
  audioUrl: string;
  provider: ProviderId;
  library: LibraryId;
  presetId: string;
  presetLabel: string;
};

type AcceptedVoice = {
  audioPath: string;
  audioUrl: string;
};


const PROVIDERS: Array<{
  id: ProviderId;
  label: string;
  detail: string;
}> = [
  {
    id: "minimax_h3",
    label: "MiniMax H3",
    detail: "Curated natural and fictional character voices.",
  },
  {
    id: "ltx25",
    label: "LTX 2.5",
    detail: "Curated natural and fictional voices generated with LTX 2.5.",
  },
];

const AGES: AgeId[] = [
  "child",
  "teenager",
  "adult",
  "elderly",
];

const PRESENTATIONS: PresentationId[] = [
  "male",
  "female",
];

// Roughly 10 seconds of natural speech at normal conversational pacing.
const AUDITION_TEXT =
  "The storm is coming fast tonight, so lock the gate before midnight, check every window twice, and stay close until the road is safe again.";

function getCharacterDeviceId() {
  if (typeof window === "undefined") return "character-web";

  const storageKey = "otg_character_device_id";
  const existing = window.localStorage.getItem(storageKey);

  if (existing) return existing;

  const value =
    typeof crypto !== "undefined" && "randomUUID" in crypto
      ? `character-${crypto.randomUUID()}`
      : `character-${Date.now()}-${Math.random().toString(16).slice(2)}`;

  window.localStorage.setItem(storageKey, value);
  return value;
}

function pretty(value: string) {
  return value
    .replace(/_/g, " ")
    .replace(/\b\w/g, (char) => char.toUpperCase());
}

export default function CharacterVoiceCreatorStage({
  character,
  processedImageUrl,
  onBackToCard,
  onSaved,
}: {
  character: CharacterRecord | null;
  processedImageUrl: string;
  onBackToCard: () => void;
  onSaved: (character: any) => void;
}) {
  const [provider, setProvider] =
    React.useState<ProviderId>("minimax_h3");

  const [library, setLibrary] =
    React.useState<LibraryId>("natural");

  const [age, setAge] =
    React.useState<AgeId>("adult");

  const [presentation, setPresentation] =
    React.useState<PresentationId>("male");

  const [catalogs, setCatalogs] =
    React.useState<Catalogs | null>(null);

  const [presetId, setPresetId] =
    React.useState("");

  const [audition, setAudition] =
    React.useState<AuditionResult | null>(null);

  const [busy, setBusy] =
    React.useState("");

  const [message, setMessage] =
    React.useState("");

  const [error, setError] =
    React.useState("");
  const [acceptedVoice, setAcceptedVoice] =
    React.useState<AcceptedVoice | null>(null);

  const presets = React.useMemo(
    () => catalogs?.[provider]?.[library] || [],
    [catalogs, provider, library],
  );

  const selectedPreset =
    presets.find((item) => item.id === presetId) ||
    presets[0] ||
    null;

  React.useEffect(() => {
    let cancelled = false;

    async function loadCatalog() {
      try {
        const response = await fetch("/api/voices/creator", {
          cache: "no-store",
          credentials: "include",
          headers: {
            "x-otg-device-id": getCharacterDeviceId(),
          },
        });

        const json = await response.json().catch(() => null);

        if (!response.ok || !json?.ok || !json.catalogs) {
          throw new Error(
            json?.error || "Could not load voice catalogs.",
          );
        }

        if (!cancelled) {
          setCatalogs(json.catalogs as Catalogs);
        }
      } catch (err) {
        if (!cancelled) {
          setError(
            err instanceof Error
              ? err.message
              : "Could not load voice catalogs.",
          );
        }
      }
    }

    void loadCatalog();

    return () => {
      cancelled = true;
    };
  }, []);

  React.useEffect(() => {
    if (!presets.length) {
      setPresetId("");
      return;
    }

    if (!presets.some((item) => item.id === presetId)) {
      setPresetId(presets[0].id);
    }
  }, [presets, presetId]);

  function clearAudition() {
    setAudition(null);
    setAcceptedVoice(null);
    setMessage("");
    setError("");
  }

  async function generateAudition() {
    if (!character?.id) {
      setError("Character identity has not been saved.");
      return;
    }

    if (!selectedPreset) {
      setError("Choose a voice before generating a sample.");
      return;
    }

    setBusy("generate");
    setError("");
    setMessage(
      `Generating a 10-second ${PROVIDERS.find((item) => item.id === provider)?.label || provider} voice sample...`,
    );
    setAudition(null);

    try {
      const response = await fetch("/api/voices/creator", {
        method: "POST",
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
          "x-otg-device-id": getCharacterDeviceId(),
        },
        body: JSON.stringify({
          action: "generate",
          characterId: character.id,
          provider,
          library,
          presetId: selectedPreset.id,
          age,
          presentation,
          text: AUDITION_TEXT,
          durationSeconds: 10,
        }),
      });

      const json = await response.json().catch(() => null);

      if (
        !response.ok ||
        !json?.ok ||
        !json?.voice?.voiceId ||
        !json?.audioUrl
      ) {
        throw new Error(
          json?.error || "Voice sample generation failed.",
        );
      }

      setAudition({
        voiceId: String(json.voice.voiceId),
        audioUrl: String(json.audioUrl),
        provider,
        library,
        presetId: selectedPreset.id,
        presetLabel: selectedPreset.label,
      });

      setMessage(
        "Voice sample ready. Listen to it, regenerate if needed, or use it for this character.",
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Voice sample generation failed.",
      );
      setMessage("");
    } finally {
      setBusy("");
    }
  }

  async function acceptAudition() {
    if (!character?.id || !audition) {
      setError("Generate a voice sample first.");
      return;
    }

    setBusy("accept");
    setError("");
    setMessage(
      "Preparing the selected voice for Voice FX...",
    );

    try {
      const response = await fetch("/api/voices/creator", {
        method: "POST",
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
          "x-otg-device-id": getCharacterDeviceId(),
        },
        body: JSON.stringify({
          action: "approve",
          characterId: character.id,
          voiceId: audition.voiceId,
          provider: audition.provider,
          library: audition.library,
          presetId: audition.presetId,
          age,
          presentation,
        }),
      });

      const json = await response.json().catch(() => null);

      if (
        !response.ok ||
        !json?.ok ||
        !json?.audioPath ||
        !json?.audioUrl
      ) {
        throw new Error(
          json?.error ||
            "Could not prepare the selected voice.",
        );
      }

      setAcceptedVoice({
        audioPath: String(json.audioPath),
        audioUrl: String(json.audioUrl),
      });

      setMessage(
        "Voice accepted. Add Voice FX below, or finish with the original voice.",
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Could not prepare the selected voice.",
      );
      setMessage("");
    } finally {
      setBusy("");
    }
  }

  async function saveFinalVoice(
    selection: FinalVoiceSelection,
  ) {
    if (!character?.id || !audition || !acceptedVoice) {
      setError("Accept a voice before finishing.");
      return;
    }

    const providerLabel =
      audition.provider === "minimax_h3"
        ? "MiniMax H3"
        : "LTX 2.5";

    const libraryLabel =
      audition.library === "natural"
        ? "Natural / Human"
        : "Unnatural / Fictional";

    setBusy("finish");
    setError("");
    setMessage("Saving final character voice...");

    try {
      const saveResponse = await fetch("/api/characters", {
        method: "POST",
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
          "x-otg-device-id": getCharacterDeviceId(),
        },
        body: JSON.stringify({
          action: "update_voice_selection",
          id: character.id,
          referenceAudioPath:
            selection.finalAudioPath,
          voiceEngineUsed: providerLabel,
          voiceStyleDefinition: [
            providerLabel,
            libraryLabel,
            audition.presetLabel,
            pretty(age),
            pretty(presentation),
            ...(selection.effectsApplied &&
            selection.voiceFxLabel
              ? [selection.voiceFxLabel]
              : []),
          ].join(", "),
          voiceSettings: {
            source: "generated",
            provider: audition.provider,
            library: audition.library,
            presetId: audition.presetId,
            presetLabel: audition.presetLabel,
            age,
            presentation,
            audioUrl: selection.finalAudioUrl,
            baseAudioPath: acceptedVoice.audioPath,
            baseAudioUrl: acceptedVoice.audioUrl,
            finalAudioPath:
              selection.finalAudioPath,
            finalAudioUrl:
              selection.finalAudioUrl,
            effectsApplied:
              selection.effectsApplied,
            voiceFx: selection.voiceFx,
          },
          metadata: {
            voiceStatus: "ready",
            voiceSource: "generated",
            voiceProvider: audition.provider,
            voiceLibrary: audition.library,
            voicePresetId: audition.presetId,
            voiceFxApplied:
              selection.effectsApplied,
          },
        }),
      });

      const saved =
        await saveResponse.json().catch(() => null);

      if (
        !saveResponse.ok ||
        !saved?.ok ||
        !saved?.character
      ) {
        throw new Error(
          saved?.error ||
            "The final character voice could not be saved.",
        );
      }

      setMessage(
        selection.effectsApplied
          ? "Character complete. The Voice FX version has been saved."
          : "Character complete. The original accepted voice has been saved.",
      );

      onSaved(saved.character);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Could not save the final character voice.",
      );
      setMessage("");
    } finally {
      setBusy("");
    }
  }

  const providerLabel =
        audition.provider === "minimax_h3"
          ? "MiniMax H3"
          : "LTX 2.5";

      const libraryLabel =
        audition.library === "natural"
          ? "Natural / Human"
          : "Unnatural / Fictional";

      const saveResponse = await fetch("/api/characters", {
        method: "POST",
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
          "x-otg-device-id": getCharacterDeviceId(),
        },
        body: JSON.stringify({
          action: "update_voice_selection",
          id: character.id,
          referenceAudioPath: String(json.audioPath),
          voiceEngineUsed: providerLabel,
          voiceStyleDefinition: [
            providerLabel,
            libraryLabel,
            audition.presetLabel,
            pretty(age),
            pretty(presentation),
          ].join(", "),
          voiceSettings: {
            source: "generated",
            provider: audition.provider,
            library: audition.library,
            presetId: audition.presetId,
            presetLabel: audition.presetLabel,
            age,
            presentation,
            audioUrl: String(json.audioUrl),
            baseAudioPath: String(json.audioPath),
            baseAudioUrl: String(json.audioUrl),
            finalAudioPath: String(json.audioPath),
            finalAudioUrl: String(json.audioUrl),
            effectsApplied: false,
          },
          metadata: {
            voiceStatus: "ready",
            voiceSource: "generated",
            voiceProvider: audition.provider,
            voiceLibrary: audition.library,
            voicePresetId: audition.presetId,
          },
        }),
      });

      const saved = await saveResponse.json().catch(() => null);

      if (!saveResponse.ok || !saved?.ok || !saved?.character) {
        throw new Error(
          saved?.error ||
            "Voice was generated but the canonical character voice could not be saved.",
        );
      }

      setMessage(
        "Character complete. The selected voice has been saved.",
      );

      onSaved(saved.character);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Could not save the selected voice.",
      );
      setMessage("");
    } finally {
      setBusy("");
    }
  }

  const providerLabel =
    PROVIDERS.find((item) => item.id === provider)?.label ||
    provider;

  return (
    <div
      className="space-y-4"
      data-otg="character-voice-creator-h3-ltx25"
    >
      <div className="rounded-[30px] border border-cyan-300/20 bg-[radial-gradient(circle_at_top_left,rgba(34,211,238,0.18),transparent_42%),rgba(2,8,16,0.94)] p-5 sm:p-7">
        <div className="flex flex-wrap items-start justify-between gap-4">
          <div>
            <div className="text-xs font-black uppercase tracking-[0.24em] text-cyan-200/75">
              Character Studio
            </div>

            <h1 className="mt-2 text-3xl font-black text-white sm:text-4xl">
              Character Voice
            </h1>

            <p className="mt-3 max-w-3xl text-sm leading-6 text-white/60">
              Choose MiniMax H3 or LTX 2.5, select a Natural /
              Human or Unnatural / Fictional voice, choose the
              character age and voice presentation, then generate
              a 10-second audition.
            </p>
          </div>

          <button
            type="button"
            onClick={onBackToCard}
            className="rounded-full border border-white/10 px-4 py-2 text-sm font-bold text-white/75"
          >
            ← Character Card
          </button>
        </div>
      </div>

      {message ? (
        <div className="rounded-xl border border-emerald-300/20 bg-emerald-400/10 p-3 text-sm text-emerald-100">
          {message}
        </div>
      ) : null}

      {error ? (
        <div className="rounded-xl border border-red-300/20 bg-red-400/10 p-3 text-sm text-red-100">
          {error}
        </div>
      ) : null}

      <div className="grid gap-4 xl:grid-cols-[minmax(0,1fr)_340px]">
        <div className="space-y-4">
          <section className="rounded-[26px] border border-cyan-300/15 bg-cyan-400/[0.04] p-5">
            <div className="text-xs font-black uppercase tracking-[0.2em] text-cyan-200/70">
              1. Voice Creator
            </div>

            <div className="mt-4 grid gap-3 sm:grid-cols-2">
              {PROVIDERS.map((item) => (
                <button
                  key={item.id}
                  type="button"
                  disabled={busy !== ""}
                  onClick={() => {
                    setProvider(item.id);
                    setPresetId("");
                    clearAudition();
                  }}
                  className={`rounded-2xl border p-4 text-left transition ${
                    provider === item.id
                      ? "border-cyan-200/70 bg-cyan-300/12"
                      : "border-white/10 bg-black/25 hover:border-white/20"
                  }`}
                >
                  <div className="text-lg font-black text-white">
                    {item.label}
                  </div>

                  <p className="mt-2 text-xs leading-5 text-white/45">
                    {item.detail}
                  </p>
                </button>
              ))}
            </div>
          </section>

          <section className="rounded-[26px] border border-violet-300/15 bg-violet-400/[0.04] p-5">
            <div className="text-xs font-black uppercase tracking-[0.2em] text-violet-200/70">
              2. Voice Library
            </div>

            <div className="mt-4 grid gap-3 sm:grid-cols-2">
              <button
                type="button"
                disabled={busy !== ""}
                onClick={() => {
                  setLibrary("natural");
                  setPresetId("");
                  clearAudition();
                }}
                className={`rounded-2xl border p-4 text-left ${
                  library === "natural"
                    ? "border-violet-200/70 bg-violet-300/12"
                    : "border-white/10 bg-black/25"
                }`}
              >
                <div className="font-black text-white">
                  Natural / Human
                </div>
                <div className="mt-1 text-xs text-white/45">
                  Regional and natural human character voices.
                </div>
              </button>

              <button
                type="button"
                disabled={busy !== ""}
                onClick={() => {
                  setLibrary("fictional");
                  setPresetId("");
                  clearAudition();
                }}
                className={`rounded-2xl border p-4 text-left ${
                  library === "fictional"
                    ? "border-violet-200/70 bg-violet-300/12"
                    : "border-white/10 bg-black/25"
                }`}
              >
                <div className="font-black text-white">
                  Unnatural / Fictional
                </div>
                <div className="mt-1 text-xs text-white/45">
                  Fantasy, creature, monster, robot, sci-fi, and
                  stylized character voices.
                </div>
              </button>
            </div>
          </section>

          <section className="rounded-[26px] border border-white/10 bg-black/30 p-5">
            <div className="text-xs font-black uppercase tracking-[0.2em] text-white/50">
              3. Choose Voice
            </div>

            <label className="mt-4 block">
              <span className="text-xs font-black uppercase tracking-[0.16em] text-white/45">
                Voice
              </span>

              <select
                value={selectedPreset?.id || ""}
                disabled={!presets.length || busy !== ""}
                onChange={(event) => {
                  setPresetId(event.target.value);
                  clearAudition();
                }}
                className="mt-2 min-h-12 w-full rounded-xl border border-white/10 bg-black/50 px-3 text-sm font-semibold text-white"
              >
                {presets.map((preset) => (
                  <option key={preset.id} value={preset.id}>
                    {preset.id}. {preset.label}
                  </option>
                ))}
              </select>
            </label>

            {selectedPreset ? (
              <div className="mt-3 rounded-xl border border-white/10 bg-white/[0.03] p-4">
                <div className="font-bold text-white">
                  {selectedPreset.label}
                </div>

                <div className="mt-1 text-xs font-semibold text-cyan-100/60">
                  {selectedPreset.category}
                </div>

                <p className="mt-2 text-xs leading-5 text-white/45">
                  {selectedPreset.description}
                </p>
              </div>
            ) : (
              <div className="mt-3 text-sm text-white/40">
                Loading voice catalog...
              </div>
            )}

            <div className="mt-5 grid gap-4 sm:grid-cols-2">
              <label>
                <span className="text-xs font-black uppercase tracking-[0.16em] text-white/45">
                  Voice
                </span>

                <select
                  value={presentation}
                  disabled={busy !== ""}
                  onChange={(event) => {
                    setPresentation(
                      event.target.value as PresentationId,
                    );
                    clearAudition();
                  }}
                  className="mt-2 min-h-12 w-full rounded-xl border border-white/10 bg-black/50 px-3 text-sm font-semibold text-white"
                >
                  {PRESENTATIONS.map((item) => (
                    <option key={item} value={item}>
                      {pretty(item)}
                    </option>
                  ))}
                </select>
              </label>

              <label>
                <span className="text-xs font-black uppercase tracking-[0.16em] text-white/45">
                  Age Range
                </span>

                <select
                  value={age}
                  disabled={busy !== ""}
                  onChange={(event) => {
                    setAge(event.target.value as AgeId);
                    clearAudition();
                  }}
                  className="mt-2 min-h-12 w-full rounded-xl border border-white/10 bg-black/50 px-3 text-sm font-semibold text-white"
                >
                  {AGES.map((item) => (
                    <option key={item} value={item}>
                      {pretty(item)}
                    </option>
                  ))}
                </select>
              </label>
            </div>

            <div className="mt-5 rounded-xl border border-white/10 bg-black/25 p-4">
              <div className="text-xs font-black uppercase tracking-[0.16em] text-white/45">
                10-Second Audition Phrase
              </div>

              <p className="mt-2 text-sm leading-6 text-white/65">
                {AUDITION_TEXT}
              </p>
            </div>

            <button
              type="button"
              disabled={
                busy !== "" ||
                !character?.id ||
                !selectedPreset
              }
              onClick={() => void generateAudition()}
              className="mt-5 min-h-12 w-full rounded-xl border border-cyan-300/30 bg-cyan-400/20 px-5 text-sm font-black text-cyan-50 disabled:opacity-40"
            >
              {busy === "generate"
                ? `Generating ${providerLabel} Sample...`
                : "Generate 10-Second Voice Sample"}
            </button>
          </section>

          {audition ? (
            <section className="rounded-[26px] border border-emerald-300/20 bg-emerald-400/[0.06] p-5">
              <div className="text-xs font-black uppercase tracking-[0.2em] text-emerald-200/75">
                Voice Sample Ready
              </div>

              <div className="mt-3 text-lg font-black text-white">
                {audition.presetLabel}
              </div>

              <div className="mt-1 text-sm text-white/50">
                {providerLabel} ·{" "}
                {library === "natural"
                  ? "Natural / Human"
                  : "Unnatural / Fictional"}{" "}
                · {pretty(age)} · {pretty(presentation)}
              </div>

              <audio
                key={audition.audioUrl}
                src={audition.audioUrl}
                controls
                preload="metadata"
                className="mt-4 w-full"
              />

              <div className="mt-4 grid gap-3 sm:grid-cols-2">
                <button
                  type="button"
                  disabled={busy !== ""}
                  onClick={() => void generateAudition()}
                  className="min-h-12 rounded-xl border border-white/15 bg-white/[0.05] px-4 text-sm font-black text-white/80 disabled:opacity-40"
                >
                  Generate Another Sample
                </button>

                <button
                  type="button"
                  disabled={busy !== ""}
                  onClick={() => void acceptAudition()}
                  className="min-h-12 rounded-xl border border-emerald-300/35 bg-emerald-400/18 px-4 text-sm font-black text-emerald-50 disabled:opacity-40"
                >
                  {acceptedVoice
                    ? "Voice Accepted"
                    : busy === "accept"
                      ? "Preparing Voice..."
                      : "Use This Voice"}
                </button>
              </div>
            </section>
          ) : null}
          {acceptedVoice && audition ? (
            <CharacterVoiceFxStage
              characterId={character?.id || ""}
              candidateId={audition.voiceId}
              inputPath={acceptedVoice.audioPath}
              inputUrl={acceptedVoice.audioUrl}
              disabled={busy !== ""}
              saving={busy === "finish"}
              onFinish={saveFinalVoice}
            />
          ) : null}
        </div>

        <aside className="space-y-4">
          <section className="rounded-[26px] border border-white/10 bg-black/30 p-4">
            <img
              src={processedImageUrl}
              alt={character?.name || "Character"}
              className="max-h-[420px] w-full rounded-xl object-contain"
              draggable={false}
            />

            <div className="mt-3 text-lg font-black text-white">
              {character?.name || "Character"}
            </div>

            <p className="mt-1 text-xs leading-5 text-white/50">
              {character?.description || ""}
            </p>
          </section>

          <section className="rounded-[26px] border border-white/10 bg-black/30 p-4">
            <div className="text-xs font-black uppercase tracking-[0.18em] text-white/45">
              Current Selection
            </div>

            <div className="mt-3 space-y-2 text-sm">
              <div className="font-bold text-white">
                {providerLabel}
              </div>

              <div className="text-white/55">
                {library === "natural"
                  ? "Natural / Human"
                  : "Unnatural / Fictional"}
              </div>

              <div className="text-white/55">
                {selectedPreset?.label || "Loading..."}
              </div>

              <div className="text-white/55">
                {pretty(presentation)} · {pretty(age)}
              </div>
            </div>
          </section>
        </aside>
      </div>
    </div>
  );
}
