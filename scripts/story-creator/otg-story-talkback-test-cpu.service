RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ReadWritePaths=/home/shawn-rochford/AI/runtime/test/story-talkback-20261101
PrivateTmp=true
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
