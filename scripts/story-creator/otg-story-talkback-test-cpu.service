[Unit]
Description=SLR Story Creator TEST Paradee and Bark CPU talkback

[Service]
Type=simple
WorkingDirectory=/home/shawn-rochford/AI/runtime/test/story-talkback-20261101
ExecStart=/home/shawn-rochford/AI/runtime/test/story-talkback-20261101/venv/bin/python /home/shawn-rochford/AI/runtime/test/story-talkback-20261101/worker/cpu_worker.py --root /home/shawn-rochford/AI/runtime/test/story-talkback-20261101
Environment=CUDA_VISIBLE_DEVICES=
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=TOKENIZERS_PARALLELISM=false
Nice=10
CPUQuota=200%
MemoryHigh=4G
MemoryMax=6G
TasksMax=64
