[Unit]
Description=OTG TEST RTX 5060 Ti Admin Gallery Agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=slrochford123
Group=slrochford123
EnvironmentFile=/etc/otg/admin-gallery-agent.env
ExecStart=/usr/bin/python3 /opt/otg-admin-gallery-agent/otg_admin_gallery_agent.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ComfyUI/output

[Install]
WantedBy=multi-user.target
