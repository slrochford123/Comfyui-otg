      "enabled": true,
      "dryRunOnly": false,
      "dangerousStop": false,
      "workingDirectory": "C:\\AI\\OTG-Test2",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "C:\\AI\\OTG-Test2\\scripts\\windows\\otg-voice-ltx-worker.ps1",
        "-Repo",
        "C:\\AI\\OTG-Test2",
        "-BaseUrl",
        "http://127.0.0.1:3001",
        "-DeviceId",
        "windows-3090-prod",
        "-WorkerId",
        "windows-3090-prod-voice-ltx-worker",
        "-ComfyUrl",
        "http://127.0.0.1:8188"
      ],
      "env": {
        "OTG_BASE_URL": "http://127.0.0.1:3001",
        "OTG_DEVICE_ID": "windows-3090-prod",
        "OTG_WORKER_ID": "windows-3090-prod-voice-ltx-worker",
        "OTG_LTX_COMFY_URL": "http://127.0.0.1:8188"
      },
      "requiredEnv": [
        "OTG_WORKER_TOKEN"
      ],
      "pidFile": "C:\\AI\\OTG-WorkerManager\\run\\voice-ltx.pid.json",
      "logPath": "C:\\AI\\OTG-WorkerManager\\logs\\voice-ltx.log",
      "stopMode": "process-tree",
      "health": {
        "commandLineContains": [
          "otg-voice-ltx-worker",
          "windows-3090-prod-voice-ltx-worker"
        ],
        "commandLineMustNotContain": [
          "--worker-token"
        ]
      },
      "idleTimeoutSeconds": 900,
      "resourceHints": [
        "gpu:windows-3090",
        "service:ltx-video"
      ],
      "description": "Local Windows TEST/dev manager entry for the LTX voice preview worker. Token is inherited from OTG_WORKER_TOKEN environment only."
